# ==============================================================================
# LabelCheck Backend Environment Configuration
# ==============================================================================

# Server Binding
HOST=0.0.0.0
PORT=8001

# Database URL
# For local development:
DATABASE_URL=sqlite:///data/labelcheck.db
# For production PostgreSQL (e.g. Neon, Render Postgres, Supabase):
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/labelcheck_db?sslmode=require

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains. In production, specify your Vercel URL.
# Example: https://labelchecker.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# Security & Authentication
# Change this to a random secret string in production
AUTH_SALT=labelcheck_production_salt_replace_in_prod

# Persistent Data Storage Directory (mount point for uploads/reports/preprocessed)
# On Render with a Persistent Disk mounted at /var/data:
# DATA_DIR=/var/data
DATA_DIR=data

# System Tesseract Path (optional; auto-detected on Linux/Docker and standard Windows paths)
# TESSERACT_CMD=/usr/bin/tesseract

# Compliance & Quality Thresholds
OCR_CONFIDENCE_THRESHOLD=65.0
LOW_QUALITY_THRESHOLD=40.0
